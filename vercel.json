{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/app.py" },
    { "src": "/login", "dest": "/app.py" },
    { "src": "/callback", "dest": "/app.py" },
    { "src": "/logout", "dest": "/app.py" },
    { "src": "/health", "dest": "/app.py" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
